# Gemstone website — managed by deploy/setup-server.sh
# Caddy obtains and renews HTTPS certificates for every domain below automatically.

gemstonebot.net {
	root * /var/www/gemstone-website
	encode zstd gzip

	# Vite fingerprints everything under /assets, so it can be cached forever.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"

	# Single-page app: unknown paths fall back to index.html.
	try_files {path} /index.html
	file_server
}

# Secondary domain and www variants redirect to the primary domain.
www.gemstonebot.net, gemmabot.io, www.gemmabot.io {
	redir https://gemstonebot.net{uri} permanent
}
